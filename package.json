{
  "name": "windbg-mcp",
  "version": "0.1.3",
  "description": "MCP server that drives cdb.exe/kd.exe (WinDbg): crash dump analysis, live user-mode debugging, and kernel debugging",
  "type": "module",
  "bin": {
    "windbg-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "windbg",
    "cdb",
    "kd",
    "debugger",
    "crash-dump",
    "kernel-debugging",
    "windows"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanren3/windbg-mcp.git"
  },
  "homepage": "https://github.com/kanren3/windbg-mcp",
  "dependencies": {
    "koffi": "^2.16.2"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/bun": "^1.2.0"
  }
}
